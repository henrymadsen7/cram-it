# Cram-It Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === REQUIRED ===
# Anthropic API key for AI tutor and script generation
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === OPTIONAL ===
# Secret key for Flask sessions (auto-generated if not set)
# SECRET_KEY=your-random-secret-key

# Course pack to load on startup (default: first available pack)
# CRAM_IT_PACK=demo-study-skills

# Server port (default: 3000)
# CRAM_IT_PORT=3000

# Data directory (default: ./data/)
# CRAM_IT_DATA_DIR=./data

# Battle mode port (default: 4000)
# BATTLE_PORT=4000
