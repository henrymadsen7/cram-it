# Cram-It Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Canvas LMS integration
CANVAS_API_URL=https://your-school.instructure.com
CANVAS_API_TOKEN=

# Optional: Custom port (default: 3000)
CRAM_IT_PORT=3000

# Optional: Custom data directory (default: ./data)
CRAM_IT_DATA_DIR=

# Secret key for session management (generate a random string)
SECRET_KEY=
