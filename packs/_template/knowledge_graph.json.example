  "core_principle": "Economics is about optimization under constraints. Firms maximize profit. Consumers maximize utility. Markets find equilibrium. Every equation on this exam is a specific case of: someone optimizing something subject to some constraint.",
  "concept_chains": {
    "firm_decisions": {
      "description": "The chain from costs to market structure to pricing. This is 60%+ of the exam.",
      "chain": [
        "production_function \u2192 cost_curves \u2192 profit_maximization \u2192 market_structure \u2192 pricing_behavior \u2192 welfare"
      ]
    },
    "consumer_decisions": {
      "description": "Budget constraints to optimal choice. ~15% of exam.",
      "chain": [
        "budget_constraint \u2192 indifference_curves \u2192 optimal_choice \u2192 demand_curve"
      ]
    },
    "macro_measurement": {
      "description": "How we measure the economy. ~10% of exam.",
      "chain": [
        "gdp_accounting \u2192 price_indices \u2192 real_vs_nominal \u2192 unemployment"
      ]
    },
    "strategic_interaction": {
      "description": "Game theory and oligopoly. ~12% of exam.",
      "chain": [
        "payoff_matrix \u2192 dominant_strategy \u2192 nash_equilibrium \u2192 prisoners_dilemma \u2192 cartel_instability"
      ]
    }
  },
  "nodes": [
    {
      "id": "production_function",
      "chapter": 14,
      "name": "The Production Function",
      "definition": "The relationship between quantity of inputs and quantity of output. Q = f(L, K).",
      "key_insight": "Diminishing marginal product is WHY cost curves are U-shaped. As you add more workers to a fixed factory, each additional worker adds less output, so the cost of each additional unit rises.",
      "depends_on": [],
      "leads_to": [
        "marginal_product",
        "cost_curves"
      ],
      "equations": [],
      "misconceptions": [
        "Students think diminishing returns means total output falls. It doesn't -- it means output increases at a DECREASING rate."
      ],
      "butler_frequency": "medium"
    },
    {
      "id": "marginal_product",
      "chapter": 14,
      "name": "Marginal Product of Labor",
      "definition": "The additional output from one more unit of labor: MPL = deltaQ / deltaL",
      "key_insight": "MPL eventually diminishes because of fixed capital. This single fact drives the shape of MC, AVC, and ATC curves.",
      "depends_on": [
        "production_function"
      ],
      "leads_to": [
        "cost_curves",
        "vmp"
      ],
      "equations": [
        {
          "name": "marginal_product",
          "formula": "MPL = change in Q / change in L",
          "when": "Given a production table, find the additional output per worker"
        }
      ],
      "misconceptions": [],
      "butler_frequency": "high"
    },
    {
      "id": "cost_curves",
      "chapter": 14,
      "name": "Cost Curves (FC, VC, TC, AFC, AVC, ATC, MC)",
      "definition": "Fixed costs don't change with output. Variable costs do. Total = Fixed + Variable. Marginal cost is the cost of one more unit.",
      "key_insight": "MC intersects ATC and AVC at their MINIMUM points. Think of it like a batting average -- if your next at-bat (marginal) is above your average, the average goes up. If below, it goes down. They must cross at the minimum.",
      "depends_on": [
        "production_function",
        "marginal_product"
      ],
      "leads_to": [
        "shutdown_decision",
        "supply_curve",
        "profit_maximization"
      ],
      "equations": [
        {
          "name": "total_cost",
          "formula": "TC = FC + VC",
          "when": "Always"
        },
        {
          "name": "marginal_cost",
          "formula": "MC = change in TC / change in Q",
          "when": "Given cost data, find MC"
        },
        {
          "name": "marginal_cost_from_wage",
          "formula": "MC = W / MPL",
          "when": "Given wage and marginal product"
        },
        {
          "name": "average_total_cost",
          "formula": "ATC = TC / Q",
          "when": "Find per-unit cost"
        },
        {
          "name": "average_variable_cost",
          "formula": "AVC = VC / Q",
          "when": "Needed for shutdown decision"
        },
        {
          "name": "average_fixed_cost",
          "formula": "AFC = FC / Q",
          "when": "Always declining -- spreading fixed costs over more units"
        }
      ],
      "misconceptions": [
        "Sunk costs (fixed costs already paid) are IRRELEVANT to production decisions. Only marginal and variable costs matter for decisions.",
        "ATC is NOT the same as MC. ATC includes fixed costs spread over output. MC only looks at the next unit."
      ],
      "butler_frequency": "very_high",
