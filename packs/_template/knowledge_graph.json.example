          "name": "budget_intercepts",
          "formula": "X-intercept = Income/Px, Y-intercept = Income/Py",
          "when": "Drawing or reading budget constraint"
        },
        {
          "name": "optimal_choice",
          "formula": "MRS = Px/Py (equivalently: MUx/Px = MUy/Py)",
          "when": "Finding the optimal consumption bundle"
        },
        {
          "name": "spending_identity",
          "formula": "If spending twice as much on X as Y: Px*X = 2*Py*Y",
          "when": "Word problems about spending ratios"
        }
      ],
