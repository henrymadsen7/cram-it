    {
      "id": "price_discrimination",
      "chapter": 16,
      "name": "Price Discrimination",
      "definition": "Selling the same good at different prices to different buyers based on willingness to pay.",
      "key_insight": "Under PERFECT price discrimination, the firm charges each buyer their exact willingness to pay. This means MR = Price for each unit (unlike regular monopoly). The firm captures ALL consumer surplus. Output actually increases to the competitive level -- so no deadweight loss.",
      "depends_on": [
        "monopoly_pricing"
      ],
      "leads_to": [],
      "equations": [
        {
          "name": "perfect_price_discrimination",
          "formula": "MR = P for each unit (charge each buyer's willingness to pay)",
          "when": "Perfect price discrimination questions -- MR equals the price on the demand curve"
        }
      ],
      "misconceptions": [
        "Students forget: with perfect price discrimination, MR = P (not the usual MR < P for monopolists)."
      ],
      "butler_frequency": "high"
    },
    {
      "id": "natural_monopoly",
      "chapter": 16,
      "name": "Natural Monopoly",
      "definition": "A monopoly that arises because one firm can supply the entire market at lower cost than multiple firms. ATC is always declining.",
      "key_insight": "If government regulates price = MC, the firm LOSES money (because ATC > MC when ATC is still declining). If price = ATC, the firm breaks even but produces less than the socially optimal quantity.",
      "depends_on": [
        "monopoly_pricing",
        "cost_curves"
      ],
      "leads_to": [],
      "equations": [],
      "misconceptions": [
        "Regulating at MC sounds ideal but causes losses. The firm needs a subsidy to survive at MC pricing."
      ],
      "butler_frequency": "high"
    },
    {
      "id": "monopolistic_competition",
      "chapter": 17,
      "name": "Monopolistic Competition",
      "definition": "Many sellers, differentiated products, free entry/exit. Each firm has a tiny bit of market power.",
      "key_insight": "Short run: acts like a monopolist (MR=MC, price from demand, can earn profit). Long run: free entry drives profit to zero (P = ATC), but P > MC always. The firm has excess capacity -- it produces less than the efficient scale.",
      "depends_on": [
        "monopoly_pricing",
        "long_run_equilibrium"
      ],
      "leads_to": [],
      "equations": [
        {
          "name": "mc_short_run",
          "formula": "MR = MC, P from demand curve (can earn profit)",
          "when": "Short-run monopolistic competition"
        },
        {
          "name": "mc_long_run",
          "formula": "P = ATC (zero profit), but P > MC always",
          "when": "Long-run -- this is what distinguishes it from perfect competition"
        }
      ],
      "misconceptions": [
        "P > MC in BOTH short run and long run. This is unique to monopolistic competition.",
        "Zero profit in long run does NOT mean P = MC. It means P = ATC."
      ],
      "butler_frequency": "high",
