      "when": "Labor demand and hiring decisions"
    },
    {
      "id": "real_gdp_eq",
      "formula": "Real GDP = Nominal GDP / (Deflator / 100)",
      "chapter": 24,
      "when": "Convert nominal to real GDP"
    },
    {
      "id": "cpi_adjust",
      "formula": "New$ = Old$ * (CPI_new / CPI_old)",
      "chapter": 25,
      "when": "Adjust dollar values for inflation"
    },
    {
      "id": "real_interest",
      "formula": "Real rate = Nominal rate - Inflation",
      "chapter": 25,
      "when": "Fisher equation"
    },
    {
      "id": "unemployment_rate_eq",
      "formula": "UR = U / (E + U) * 100",
      "chapter": 29,
      "when": "Calculate unemployment rate"
    },
    {
      "id": "lfpr",
      "formula": "LFPR = (E + U) / Population * 100",
      "chapter": 29,
      "when": "Labor force participation rate"
    },
    {
      "id": "nash",
      "formula": "Best response for each player given opponent's choice",
      "chapter": 18,
      "when": "Payoff matrix -- check each cell"
    },
    {
      "id": "pairwise",
      "formula": "Compare each pair of options, majority wins each matchup",
      "chapter": 23,
      "when": "Voting preference tables"
    }
  ],
  "butler_patterns": {
    "description": "How Butler constructs exam questions -- patterns across 3 exams",
    "patterns": [
      "He gives a cost/revenue TABLE and asks you to find the profit-maximizing quantity or price. You need MR=MC.",
      "He gives employment data and asks for unemployment rate AND participation rate in the same question. Know both formulas.",
      "He gives a payoff matrix and asks for Nash equilibrium AND whether players have dominant strategies. Check ALL cells.",
      "He asks about shutdown with specific numbers: P, AVC, ATC given. Compare P to AVC for short-run, P to ATC for long-run.",
      "He tests monopolistic competition long-run adjustment: entry reduces demand, profit goes to zero, but P > MC always.",
      "He gives a budget constraint scenario with spending ratios ('spends twice as much on X as Y') and asks for a price.",
      "He asks what happens when a competitive firm increases output -- price does NOT change (price taker).",
      "He tests perfect price discrimination: MR = P, no deadweight loss, firm captures all surplus.",
      "He gives CPI data across two years and asks you to adjust a dollar amount or Social Security payment.",
      "He tests natural monopoly regulation: if P = MC, the firm earns LOSSES (ATC > MC when ATC is declining)."
    ]
  },
