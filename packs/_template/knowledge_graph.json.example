    {
      "id": "profit_maximization",
      "chapter": 14,
      "name": "Profit Maximization: MR = MC",
      "definition": "A firm maximizes profit by producing where marginal revenue equals marginal cost.",
      "key_insight": "This works for ALL firm types -- competitive, monopoly, everything. The difference is how MR is determined. For competitive firms, MR = P. For monopolists, MR < P.",
      "depends_on": [
        "cost_curves"
      ],
      "leads_to": [
        "competitive_firm",
        "monopoly_pricing"
      ],
      "equations": [
        {
          "name": "profit",
          "formula": "Profit = TR - TC = (P - ATC) * Q",
          "when": "Calculate actual profit at the optimal quantity"
        },
        {
          "name": "profit_max_rule",
          "formula": "Produce where MR = MC",
          "when": "EVERY profit maximization question"
        }
      ],
      "misconceptions": [
        "MR = MC does NOT mean profit is zero. It means profit is MAXIMIZED. Profit = (P - ATC) * Q at that point.",
        "If P < ATC at the optimal Q, the firm is making a LOSS but it might still operate (if P > AVC)."
      ],
      "butler_frequency": "very_high"
    },
    {
      "id": "shutdown_decision",
      "chapter": 15,
      "name": "Shutdown vs. Exit",
      "definition": "Short run: shut down if P < AVC (or TR < VC). Long run: exit if P < ATC.",
      "key_insight": "Shutting down means you still pay fixed costs but earn zero revenue. Operating at a loss can be BETTER than shutting down if revenue covers variable costs and contributes something toward fixed costs. The question is: 'Am I losing MORE by operating than by closing?'",
      "depends_on": [
        "cost_curves",
        "profit_maximization"
      ],
      "leads_to": [
        "supply_curve"
      ],
      "equations": [
        {
          "name": "shutdown_rule_short_run",
          "formula": "Shut down if P < AVC (equivalently: TR < VC)",
          "when": "Comparing price to AVC"
        },
        {
          "name": "exit_rule_long_run",
          "formula": "Exit if P < ATC",
          "when": "Long-run decision with no fixed costs"
        }
      ],
      "misconceptions": [
        "Students confuse shutdown (short-run, temporary) with exit (long-run, permanent).",
        "If P < ATC but P > AVC: the firm OPERATES in the short run but will EXIT in the long run.",
        "Sunk costs dont factor in. If you already paid rent, that's gone whether you operate or not."
      ],
      "butler_frequency": "high"
    },
    {
      "id": "supply_curve",
      "chapter": 15,
      "name": "Competitive Firm's Supply Curve",
      "definition": "The firm's supply curve IS its MC curve above AVC.",
      "key_insight": "Below AVC, the firm shuts down (supplies zero). Above AVC, it produces where P = MC. So supply = MC above AVC.",
      "depends_on": [
        "shutdown_decision",
        "cost_curves"
      ],
      "leads_to": [
        "market_equilibrium",
        "long_run_equilibrium"
      ],
      "equations": [],
      "misconceptions": [
        "Monopolists do NOT have a supply curve -- they set price and quantity simultaneously."
      ],
      "butler_frequency": "high"
    },
    {
      "id": "competitive_firm",
      "chapter": 15,
      "name": "Perfect Competition",
      "definition": "Many buyers and sellers, identical products, free entry/exit, price takers.",
      "key_insight": "A competitive firm is a PRICE TAKER. It can sell as much as it wants at the market price. MR = P for competitive firms. If a competitive firm increases output by 30%, price does NOT change.",
      "depends_on": [
        "profit_maximization"
      ],
      "leads_to": [
        "long_run_equilibrium",
        "supply_curve"
      ],
      "equations": [
        {
          "name": "competitive_mr",
          "formula": "MR = P = AR (for competitive firms)",
          "when": "Identifying competitive firm behavior"
        }
      ],
      "misconceptions": [
        "A competitive firm can still earn economic profit in the SHORT run. Free entry drives profit to zero in the LONG run.",
        "Price taker means the firm CANNOT influence price, not that the firm doesnt care about price."
      ],
      "butler_frequency": "very_high"
    },
    {
      "id": "long_run_equilibrium",
      "chapter": 15,
      "name": "Long-Run Competitive Equilibrium",
      "definition": "In the long run, free entry and exit drive economic profit to zero. P = ATC at the minimum of ATC.",
      "key_insight": "If firms are making profit, new firms enter, supply increases, price falls until profit = 0. If firms are losing money, firms exit, supply decreases, price rises until profit = 0. The invisible hand at work.",
      "depends_on": [
        "competitive_firm",
        "supply_curve"
      ],
      "leads_to": [],
      "equations": [
        {
          "name": "long_run_zero_profit",
          "formula": "P = ATC (minimum) in long-run equilibrium",
          "when": "Long-run competitive market questions"
        }
      ],
      "misconceptions": [
        "Zero economic profit does NOT mean zero accounting profit. The firm still covers all opportunity costs including normal return on investment."
      ],
      "butler_frequency": "high"
    },
    {
      "id": "monopoly_pricing",
      "chapter": 16,
      "name": "Monopoly Pricing and Output",
      "definition": "A monopolist faces the market demand curve. MR < P because selling one more unit requires lowering price on ALL units.",
      "key_insight": "The monopolist finds Q where MR = MC, then goes UP to the demand curve to find the price. Two-step process: (1) find optimal Q from MR=MC, (2) find P from demand curve at that Q. The monopolist does NOT have a supply curve.",
      "depends_on": [
        "profit_maximization"
      ],
      "leads_to": [
        "monopoly_deadweight_loss",
        "price_discrimination",
        "natural_monopoly"
      ],
      "equations": [
        {
          "name": "monopoly_pricing_rule",
          "formula": "Find Q where MR = MC, then P from demand curve at that Q",
          "when": "Every monopoly pricing question"
        },
        {
          "name": "monopoly_profit",
          "formula": "Profit = (P - ATC) * Q",
          "when": "After finding optimal P and Q"
        }
      ],
      "misconceptions": [
        "If MC rises by $1, monopoly price rises by LESS than $1 (because MR curve is steeper than demand).",
        "A monopolist doesnt charge the highest possible price -- it charges the profit-MAXIMIZING price.",
        "Monopolists CAN earn losses if ATC is above the demand curve at all quantities."
      ],
      "butler_frequency": "very_high",
      "butler_slides": [
