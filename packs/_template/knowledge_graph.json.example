      "id": "income_substitution_effects",
      "chapter": 22,
      "name": "Income and Substitution Effects",
      "definition": "When price changes: substitution effect (buy more of the cheaper good) and income effect (your purchasing power changed).",
      "key_insight": "For normal goods, both effects work the same direction. For inferior goods, they oppose. If income effect dominates substitution effect for a wage increase, you get a BACKWARD-BENDING labor supply curve (people work LESS when wages rise because they're rich enough).",
      "depends_on": [
        "consumer_choice"
      ],
      "leads_to": [],
      "equations": [],
      "misconceptions": [
        "Giffen goods (where demand rises with price) require the income effect to dominate the substitution effect. Extremely rare."
      ],
      "butler_frequency": "medium"
    },
    {
      "id": "moral_hazard_asymmetric",
      "chapter": 23,
      "name": "Moral Hazard, Adverse Selection, and Asymmetric Information",
      "definition": "Moral hazard: after a deal, one party takes more risk because they're insured. Adverse selection: before a deal, the wrong types show up. Principal-agent: interests of boss and employee diverge.",
      "key_insight": "Signaling (education as a signal of ability) and screening (insurance companies requiring health exams) are market responses to information problems. Efficiency wages (paying above market) reduce moral hazard by making workers afraid to lose their jobs.",
      "depends_on": [],
      "leads_to": [],
      "equations": [],
      "misconceptions": [
        "March Madness reducing productivity is moral hazard (workers shirking), not adverse selection."
      ],
      "butler_frequency": "medium"
    },
